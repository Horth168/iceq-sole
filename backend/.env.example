# =====================================================================
# IceQ Sole backend configuration
# Copy this file to `.env` (same folder) and fill in your own values.
# NEVER commit the real .env file.
# =====================================================================

# --- Core -------------------------------------------------------------
ENVIRONMENT=development
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters

# Local development uses SQLite automatically when DATABASE_URL is empty/absent.
# Production (PostgreSQL):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/iceq_sole
DATABASE_URL=

# --- Auth -------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# "Remember me" keeps customers signed in this many days (otherwise 1 day)
REMEMBER_ME_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=60

# --- Email (password reset) ---------------------------------------------
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASSWORD.
# Never use your normal Gmail password. Leave SMTP_HOST empty to disable email
# (in development the reset link is printed in the backend log instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=IceQ Sole

# --- Web --------------------------------------------------------------
# Comma separated list of allowed frontends (storefront + dashboard)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
STORE_URL=http://localhost:5173
# Public URL of this API (used for locally stored image URLs)
API_PUBLIC_URL=http://localhost:8000
RATE_LIMIT_ENABLED=true

# --- Image storage ----------------------------------------------------
# local       = saves to backend/uploads (development only)
# cloudflare  = Cloudflare R2 (recommended for production)
# firebase    = Firebase Storage
STORAGE_PROVIDER=local
MAX_UPLOAD_MB=8

# Cloudflare R2 (STORAGE_PROVIDER=cloudflare)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=iceq-sole-media
# Public bucket URL (r2.dev) or your custom domain, e.g. https://media.iceqsole.com
R2_PUBLIC_URL=

# Firebase Storage (STORAGE_PROVIDER=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Path to the service-account JSON file (kept OUTSIDE git), or the JSON itself as a secret
FIREBASE_SERVICE_ACCOUNT=

# --- Payments: Bakong KHQR (works with ABA and every Bakong member bank) ---
# Your Bakong account ID, e.g. yourname@abaa   (shown inside the QR code)
BAKONG_ACCOUNT_ID=
# Token from https://api-bakong.nbc.gov.kh  — enables automatic payment verification
BAKONG_API_TOKEN=
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
KHQR_EXPIRY_MINUTES=30

# --- Locale -----------------------------------------------------------
TIMEZONE=Asia/Phnom_Penh

# --- Hosting without a shell (e.g. Render free plan) ------------------------
# INITIAL_ADMIN_EMAIL / INITIAL_ADMIN_PASSWORD create the first admin on start-up
# (only if no admin exists yet). Remove them after your first sign-in.
# SEED_DEMO_CATALOG=true loads/updates the demo catalogue with the credited
# Unsplash photos in seed_assets/ (never deletes orders or customers).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
SEED_DEMO_CATALOG=false
